# Copy to .env and fill in. Every value can also be passed as a real environment variable.

# --- Secrets ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=              # owner chat: notifications + bot commands
TELEGRAM_CHANNEL_ID=           # optional public channel (-100...) for auto-posts
PEXELS_API_KEY=                # https://www.pexels.com/api/ — empty = gradient backgrounds
YOUTUBE_API_KEY=               # read-only key for `autoy analytics`

# --- Channels --------------------------------------------------------------
TELEGRAM_NEWS_CHANNEL=geo      # which channel's topics feed the Telegram channel
YOUTUBE_CHANNEL_IDS=geo=UCxxxxxxxxxxxxxxxxxxxxxx   # for /stats and milestone alerts

# --- Scheduling ------------------------------------------------------------
SCHEDULE_TIMES=10:00,19:00
WEEKLY_TIME=10:00
WEEKLY_CHANNEL=geo
WEEKLY_MAX_TOPICS=8
TELEGRAM_CHANNEL_TIMES=09:00,12:00,15:00,18:00,21:00
MAX_POSTS_PER_DAY=5

# --- Rendering -------------------------------------------------------------
VIDEO_FPS=30
MAX_DURATION_SEC=34
SCENE_DURATION_SEC=2.2
FONT_BOLD=/usr/share/fonts/liberation/LiberationSans-Bold.ttf
FONT_REGULAR=/usr/share/fonts/liberation/LiberationSans-Regular.ttf

# --- YouTube quota (local estimate for /quota) ------------------------------
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_UPLOAD_QUOTA_COST=1600

# --- Paths ------------------------------------------------------------------
# AUTOY_HOME=/opt/autoy       # defaults to the current working directory
